# ORBIT Environment Configuration Example
PROJECT_NAME="ORBIT — Autonomous Business Operations Intelligence"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Persistence
# Local quickstart SQLite:
DATABASE_URL=sqlite:///./orbit.db
# Or PostgreSQL for production:
# DATABASE_URL=postgresql://orbit_user:orbit_password@localhost:5432/orbit_db

# AI / Model Configuration (Optional: system runs 100% deterministically offline if omitted)
GEMINI_API_KEY=
LLM_PROVIDER=deterministic
MODEL_NAME=gemini-2.0-flash
